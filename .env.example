# Local development only. Supply unique high-entropy secrets in production.
APP_ENV=development
APP_NAME=AppForge
LOG_LEVEL=INFO
APP_AUTH_SECRET=replace-with-a-long-random-secret-before-any-shared-deployment
APP_DATABASE_PATH=data/appforge.db

# Optional real model providers. Keys are never stored in the database.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Docker sandbox is opt-in and disabled by default.
APP_ENABLE_SANDBOX=false
